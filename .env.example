# FastMCP Configuration
LIVEGREP_API_URL=https://your-livegrep-server.example.com
# Instances behind a sign-in open a browser window when needed (see README).
# Optional, instead of that: the cookies of a private-window session
# LIVEGREP_COOKIE=session=abc123; other_cookie=value
# LIVEGREP_STATE_DIR=~/.livegrep-mcp
# LIVEGREP_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# LIVEGREP_AUTO_LOGIN=0
